# Copy to .env in the project root. FastAPI loads .env on startup.
# Process environment variables take precedence. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional separate model for semantic task scoring; otherwise OPENAI_MODEL:
# OPENAI_RATING_MODEL=gpt-4.1-mini
# Optional absolute path to a different local SQLite database:
# APP_DB_PATH=/tmp/hackalem-demo.sqlite3
# Only used when starting Next.js separately:
BACKEND_URL=http://127.0.0.1:8000
